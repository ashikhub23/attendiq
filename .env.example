# ---- Flask ----
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production
DATABASE_URL=sqlite:///database/attendance.db

# ---- College Portal (used ONLY by Selenium, never shown in the UI) ----
PORTAL_URL=https://your-college-portal.example.com/login
PORTAL_USERNAME=your_hod_username
PORTAL_PASSWORD=your_hod_password

# ---- Portal Supabase backend (live subject lists) ----
PORTAL_SUPABASE_URL=
PORTAL_SUPABASE_ANON_KEY=

# ---- App login (the account YOU use to log into this dashboard) ----
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=ChangeMe123!

# ---- Selenium ----
SELENIUM_HEADLESS=true
SELENIUM_IMPLICIT_WAIT=10
